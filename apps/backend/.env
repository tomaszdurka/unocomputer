# Non-secret local defaults; committed on purpose. Secrets go in .env.local (gitignored).
#
# DATABASE_URL: relative sqlite paths resolve against the prisma/ schema directory,
# so this points at <repo-root>/data/unocomputer.db - the same directory as the socket.
# In deployment, set DATABASE_URL as a real environment variable with an absolute path
# (scripts/deploy-local.sh does); it takes precedence over this file.
DATABASE_URL="file:../../../data/unocomputer.db"

# The backend has no TCP port. It listens on a unix domain socket (default:
# <repo-root>/data/backend.sock) and the admin proxies /api/* to it. For direct
# debugging: curl --unix-socket data/backend.sock http://localhost/api/runs

# SESSIONS_DIR: where the backend keeps what it needs to resume a CLI conversation
# (codex/gemini session ids). Default: <repo-root>/data/sessions. Never a workspace
# folder - a workspace can be bound to a real project directory.
