# Transport
# The backend has no TCP port. It listens on a unix socket at <repo>/data/backend.sock
# and is reachable only through the admin's /api proxy. For direct debugging:
#   curl --unix-socket data/backend.sock http://localhost/api/runs
# SOCKET_PATH=/absolute/path/to/backend.sock

# Workspace Configuration
# Custom directory for Claude workspaces (optional)
# Default: ./workspaces (relative to the backend app dir)
# WORKSPACES_DIR=/var/data/run-workspaces

# Database Configuration
# Prisma reads DATABASE_URL. A relative sqlite path resolves against the prisma/ schema
# directory, so the committed default in .env points at <repo-root>/data/unocomputer.db.
# Set it here (or as a real environment variable, which wins) to move the database.
# DATABASE_URL=file:/absolute/path/to/unocomputer.db

# SESSIONS_DIR: where the backend keeps what it needs to resume a CLI conversation
# (codex/gemini session ids). Default: <repo-root>/data/sessions.
# SESSIONS_DIR=/absolute/path/to/sessions
