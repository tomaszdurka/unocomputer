# Transport
# By default the backend listens on a unix socket at <repo>/data/backend.sock and is
# reachable only through the admin's /api proxy - it binds no TCP port at all.
# Set PORT to bind 127.0.0.1:<port> instead (debugging escape hatch).
# PORT=4101
# SOCKET_PATH=/absolute/path/to/backend.sock

# Workspace Configuration
# Custom directory for Claude workspaces (optional)
# Default: ./workspaces (relative to the backend app dir)
# WORKSPACES_DIR=/var/data/run-workspaces

# Database Configuration
# SQLite database path (optional)
# Default: ./data/uno-computer.db (relative to the backend app dir)
# DATABASE_PATH=./data/uno-computer.db
