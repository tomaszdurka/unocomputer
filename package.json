{
  "name": "unocomputer",
  "version": "1.0.0",
  "description": "UnoComputer - Local Model API with workspace isolation",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "quality": "pnpm -r run quality",
    "start": "pnpm --parallel -r run start",
    "deploy:local": "bash scripts/deploy-local.sh"
  },
  "keywords": [
    "claude",
    "api",
    "typescript",
    "nextjs",
    "nestjs"
  ],
  "author": "",
  "license": "ISC",
  "pnpm": {
    "overrides": {
      "better-sqlite3": "^12.11.1"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "better-sqlite3",
      "esbuild",
      "sharp"
    ]
  }
}
