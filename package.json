{
  "name": "unocomputer",
  "version": "1.0.0",
  "description": "UnoComputer - Local Model API with workspace isolation",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm -r run build",
    "deploy:local": "bash scripts/deploy-local.sh",
    "dev": "pnpm --parallel -r run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r run lint",
    "quality": "pnpm -r run quality",
    "start": "pnpm --parallel -r run start",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck"
  },
  "keywords": [
    "claude",
    "api",
    "typescript",
    "nextjs",
    "nestjs"
  ],
  "author": "",
  "license": "ISC",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "esbuild",
      "prisma",
      "sharp"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
